NODE_ENV=development
PORT=3001
# Matches docker-compose.yml
DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafe_central?schema=public
# Comma-separated list of allowed browser origins (admin and web dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Staff session lifetime in hours.
SESSION_TTL_HOURS=12
# Admin app base URL; password-reset emails link to <ADMIN_URL>/reset-password.
ADMIN_URL=http://localhost:3000
# Initial owner created by `npm run db:seed` (choose your own; 12+ chars, not guessable).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner
# Set to true to enroll the owner in TOTP MFA; the seed prints the otpauth:// URI once.
SEED_OWNER_MFA=false

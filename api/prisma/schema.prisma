// Models are added by each module in src/modules/<module>.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── auth (src/modules/auth) ──────────────────────────────────────────────

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum SessionStage {
  MFA_PENDING
  AUTHENTICATED
}

model StaffUser {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                StaffRole            @default(STAFF)
  passwordHash        String
  /// Base32 TOTP secret; null when no authenticator app is enrolled.
  mfaSecret           String?
  mfaLastUsedStep     Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  issuedQrCredentials TableQrCredential[]

  @@map("staff_users")
}

model Session {
  id         String       @id @default(cuid())
  /// SHA-256 of the cookie token.
  tokenHash  String       @unique
  userId     String
  user       StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      SessionStage
  remember   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 of the emailed token.
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── venue (src/modules/venue) ────────────────────────────────────────────
// Single venue: one row with id "main", created by the seed.

enum VenueLinkNetwork {
  INSTAGRAM
  FACEBOOK
  WEBSITE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum BillRequestMode {
  TABLE
  REGISTER
  TRANSFER
}

model Venue {
  id              String                @id @default("main")
  name            String
  description     String?
  coverImageUrl   String
  /// Street and city are both set or both null.
  addressStreet   String?
  addressCity     String?
  addressMapsUrl  String?
  whatsapp        String?
  phone           String?
  /// IANA time zone of the opening hours.
  timezone        String
  updatedAt       DateTime              @updatedAt
  links           VenueLink[]
  openingHours    VenueOpeningHours[]
  paymentSettings VenuePaymentSettings?

  @@map("venues")
}

model VenueLink {
  venueId  String
  venue    Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  network  VenueLinkNetwork
  position Int
  handle   String
  url      String?

  @@id([venueId, network])
  @@map("venue_links")
}

/// One opening range per open weekday; missing weekdays are closed.
model VenueOpeningHours {
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday  Weekday
  /// "HH:MM", venue local time.
  opensAt  String
  closesAt String

  @@id([venueId, weekday])
  @@map("venue_opening_hours")
}

model VenuePaymentSettings {
  venueId           String            @id
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  acceptedMethods   PaymentMethod[]
  billRequestModes  BillRequestMode[]
  bankHolder        String
  bankName          String
  bankAlias         String
  bankCbu           String
  staffInstructions String
  version           Int               @default(1)
  updatedAt         DateTime

  @@map("venue_payment_settings")
}

// ── tables (src/modules/tables) ──────────────────────────────────────────
// Configuration only (sessions come later): spaces in display order, tables with their
// floor-plan box, and QR credentials. Credentials outlive a deleted table (tableId set to
// null) so a token or a table number is never issued again.

enum SpaceIcon {
  STORE
  SUN
  TREES
  MAP_PIN
}

enum SpaceTone {
  BRAND
  WARNING
  SUCCESS
  NEUTRAL
}

enum TableShape {
  RECT
  ROUND
}

model VenueSpace {
  /// Slug of the first name, e.g. "salon".
  id       String       @id
  name     String
  icon     SpaceIcon
  tone     SpaceTone
  /// Display order of tabs and filters, from 0.
  position Int
  tables   VenueTable[]

  @@map("venue_spaces")
}

model VenueTable {
  /// "tbl_07", derived from the number.
  id           String              @id
  /// Public identity used by the QR URL; never reused.
  number       Int                 @unique
  label        String              @unique
  spaceId      String
  space        VenueSpace          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  capacity     Int
  description  String              @default("")
  enabled      Boolean             @default(true)
  /// Bumped by every configuration change (display and audit only).
  version      Int                 @default(1)
  /// Box on the space's 780×620 plan, in plan units.
  layoutX      Int
  layoutY      Int
  layoutWidth  Int
  layoutHeight Int
  layoutShape  TableShape          @default(RECT)
  credentials  TableQrCredential[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([spaceId])
  @@map("venue_tables")
}

/// One active credential per table (revokedAt null); rotated ones carry an audit number.
model TableQrCredential {
  id          String      @id @default(cuid())
  /// 10 alphanumeric characters, unique across every credential ever issued.
  token       String      @unique
  tableId     String?
  table       VenueTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// Number of the table it was issued for, kept after the table is deleted.
  tableNumber Int
  issuedAt    DateTime
  issuedById  String
  issuedBy    StaffUser   @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  revokedAt   DateTime?
  /// Audit entry of a rotation ("QR-118"); null when revoked by deleting the table.
  auditNumber Int?        @unique

  @@index([tableId])
  @@map("table_qr_credentials")
}

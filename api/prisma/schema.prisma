// Models are added by each module in src/modules/<module>.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── auth (src/modules/auth) ──────────────────────────────────────────────

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum SessionStage {
  MFA_PENDING
  AUTHENTICATED
}

model StaffUser {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                StaffRole            @default(STAFF)
  passwordHash        String
  /// Base32 TOTP secret; null when no authenticator app is enrolled.
  mfaSecret           String?
  mfaLastUsedStep     Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("staff_users")
}

model Session {
  id         String       @id @default(cuid())
  /// SHA-256 of the cookie token.
  tokenHash  String       @unique
  userId     String
  user       StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage      SessionStage
  remember   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime     @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 of the emailed token.
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── venue (src/modules/venue) ────────────────────────────────────────────
// Single venue: one row with id "main", created by the seed.

enum VenueLinkNetwork {
  INSTAGRAM
  FACEBOOK
  WEBSITE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum BillRequestMode {
  TABLE
  REGISTER
  TRANSFER
}

model Venue {
  id              String                @id @default("main")
  name            String
  description     String?
  coverImageUrl   String
  /// Street and city are both set or both null.
  addressStreet   String?
  addressCity     String?
  addressMapsUrl  String?
  whatsapp        String?
  phone           String?
  /// IANA time zone of the opening hours.
  timezone        String
  updatedAt       DateTime              @updatedAt
  links           VenueLink[]
  openingHours    VenueOpeningHours[]
  paymentSettings VenuePaymentSettings?

  @@map("venues")
}

model VenueLink {
  venueId  String
  venue    Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  network  VenueLinkNetwork
  position Int
  handle   String
  url      String?

  @@id([venueId, network])
  @@map("venue_links")
}

/// One opening range per open weekday; missing weekdays are closed.
model VenueOpeningHours {
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  weekday  Weekday
  /// "HH:MM", venue local time.
  opensAt  String
  closesAt String

  @@id([venueId, weekday])
  @@map("venue_opening_hours")
}

model VenuePaymentSettings {
  venueId           String            @id
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  acceptedMethods   PaymentMethod[]
  billRequestModes  BillRequestMode[]
  bankHolder        String
  bankName          String
  bankAlias         String
  bankCbu           String
  staffInstructions String
  version           Int               @default(1)
  updatedAt         DateTime

  @@map("venue_payment_settings")
}
